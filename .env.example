# Google AI Studio API key (server-only)
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.1-pro-preview
GEMINI_MODEL=
# Optional thinking level: low | medium | high (default high)
GEMINI_REASONING_EFFORT=high
# Report content source: gemini | sample
# `sample` returns fixed local content for the base report, the deep report and
# the custom follow-up questions, and never calls the Gemini API.
REPORT_PROVIDER=gemini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Deep analysis paid-flow price and provider: mock | alipay_sandbox | alipay
DEEP_REPORT_PRICE=¥29.90
DEEP_REPORT_AMOUNT=29.90
PAYMENT_PROVIDER=mock
PAYMENT_RECEIPT_SECRET=
MOCK_PAYMENT_SECRET=
# Optional: success | failure (defaults to success)
MOCK_PAYMENT_OUTCOME=success

# Alipay (server-only; required when PAYMENT_PROVIDER is alipay_sandbox or alipay)
# alipay targets the live gateway and needs a published app with the WAP
# payment product enabled; alipay_sandbox keeps the test environment.
APP_URL=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS8
# Optional; defaults to the gateway that matches PAYMENT_PROVIDER
ALIPAY_GATEWAY=
# Optional overrides; otherwise derived from APP_URL
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
