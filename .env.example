# Which report API to use: kie (default) or google
GEMINI_PROVIDER=kie
# Server-only API key: Kie key when GEMINI_PROVIDER=kie, Google AI Studio key when google
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.1-pro-openai (kie) or gemini-3.1-pro-preview (google)
GEMINI_MODEL=
# Optional thinking level: low | medium | high (default high)
GEMINI_REASONING_EFFORT=high
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
